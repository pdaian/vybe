def clean_commit_subject(text: str) -> str:
    line = text.strip()
    if not line:
        return ""
    line = re.sub(r"^[\-\*\d\.\)\s]+", "", line)
    line = re.sub(r"^prompt\s+\d+\s+summary\s*:\s*", "", line, flags=re.I)
    line = re.sub(r"^(summary|result|changes?|updated?|implemented?)\s*:\s*", "", line, flags=re.I)
    line = re.sub(r"\s+", " ", line).strip(" .:-")
    return line


def extract_commit_subjects(*texts: str) -> List[str]:
    subjects: List[str] = []
    seen: set[str] = set()
    for text in texts:
        for raw_line in text.splitlines():
            subject = clean_commit_subject(raw_line)
            if not subject:
                continue
            lowered = subject.lower()
            if lowered in GENERIC_COMMIT_SUBJECTS or lowered.startswith("net diff:") or lowered in seen:
                continue
            seen.add(lowered)
            subjects.append(subject)
    return subjects


def extract_commit_subject(*texts: str) -> str:
    subjects = extract_commit_subjects(*texts)
    return subjects[0] if subjects else ""


def normalize_commit_tag(value: str) -> str:
    tag = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip())
    return tag.strip("-")


def derive_commit_tag(branch: str, temp_root: Optional[Path] = None) -> str:
    normalized_branch = normalize_commit_tag(branch.rsplit("/", 1)[-1])
    if normalized_branch:
        return normalized_branch

    if temp_root is not None:
        tag = temp_root.name
        if tag.startswith("codex-run-"):
            tag = tag[len("codex-run-") :]
        normalized = normalize_commit_tag(tag)
        if normalized:
            return normalized

    return "workspace"


def clip_commit_subject(subject: str, prefix: str) -> str:
    max_len = max(20, 72 - len(prefix) - 2)
    subject = subject.strip()
    if len(subject) <= max_len:
        return subject
    return subject[: max_len - 3].rstrip() + "..."


def fallback_commit_subject(changed_files: Optional[List[ChangedFile]] = None) -> str:
    files = changed_files or []
    if len(files) == 1:
        ch = files[0]
        verb = {
            "A": "add",
            "D": "remove",
            "M": "update",
        }.get(ch.status, "update")
        return f"{verb} {ch.path}"
    return "apply requested changes"


def make_commit_body(summary: str, subject: str) -> str:
    normalized_subject = clean_commit_subject(subject).lower()
    lines: List[str] = []
    for raw_line in summary.splitlines():
        line = raw_line.strip()
        if not line:
            if lines and lines[-1] != "":
                lines.append("")
            continue
        if clean_commit_subject(line).lower() == normalized_subject:
            continue
        lines.append(line)

    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()

    body = "\n".join(lines).strip()
    return body or "Summary: No additional details captured."


def make_commit_message(
    prompt_text: str,
    summary: str,
    branch: str,
    temp_root: Optional[Path] = None,
    summary_history: Optional[List[str]] = None,
    ch: Optional[ChangedFile] = None,
    changed_files: Optional[List[ChangedFile]] = None,
) -> Tuple[str, str]:
    summary_subjects: List[str] = []
    if summary_history:
        seen: set[str] = set()
        for entry in summary_history:
            subject = extract_commit_subject(entry)
            if not subject:
                continue
            lowered = subject.lower()
            if lowered in seen:
                continue
            seen.add(lowered)
            summary_subjects.append(subject)
    else:
        summary_subjects = extract_commit_subjects(summary)

    if summary_subjects:
        subject = "; ".join(summary_subjects)
    else:
        subject = extract_commit_subject(prompt_text)
    if not subject:
        subject = fallback_commit_subject([ch] if ch else changed_files)
    subject_prefix = f"[{derive_commit_tag(branch, temp_root)}] {COMMIT_PREFIX}"
    subject = f"{subject_prefix}: {clip_commit_subject(subject, subject_prefix)}"
    return subject, make_commit_body(summary, subject)


def result_has_prompt_branches(result: RunResult) -> bool:
    return any(
        event.event_type == "branch_start"
        for event in result.execution_events
    )


def branch_graph_can_be_replayed(repo: Path, result: RunResult) -> bool:
    submodule_paths = get_submodule_paths(repo)
    if any(
        split_repo_relpath(ch.path, submodule_paths)[0]
        for ch in result.changed_files
    ):
        return False

    visible_paths = {ch.path for ch in result.changed_files}
    snapshot_paths = {
        path
        for _status, path in git_snapshot_diff_entries(result.working_dir)
    }
    return snapshot_paths == visible_paths


def ensure_prompt_branches_available(
    repo: Path,
    events: Sequence[PromptExecutionEvent],
) -> None:
    branch_names = [
        event.branch_name
        for event in events
        if event.event_type == "branch_start"
    ]
    if len(branch_names) != len(set(branch_names)):
        raise CommandError("Prompt execution produced duplicate Git branch names.")

    collisions: List[str] = []
    for branch_name in branch_names:
        proc = run_cmd(
            ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch_name}"],
            cwd=repo,
            check=False,
        )
        if proc.returncode == 0:
            collisions.append(branch_name)
    if collisions:
        joined = ", ".join(collisions)
        raise CommandError(
            "Cannot replay the prompt tree because these local branches already "
            f"exist: {joined}"
        )


def verify_replayed_tree(repo: Path, changed_files: Sequence[ChangedFile]) -> None:
    mismatches: List[str] = []
    for ch in changed_files:
        actual = repo / ch.path
        expected = ch.new_abs
        if ch.status == "D":
            if actual.exists() or actual.is_symlink():
                mismatches.append(ch.path)
            continue
        if expected is None:
            mismatches.append(ch.path)
            continue
        if actual.is_symlink() or expected.is_symlink():
            if not (
                actual.is_symlink()
                and expected.is_symlink()
                and os.readlink(actual) == os.readlink(expected)
            ):
                mismatches.append(ch.path)
            continue
        if actual.is_dir() or expected.is_dir():
            if not (actual.is_dir() and expected.is_dir()):
                mismatches.append(ch.path)
            continue
        if not actual.is_file() or actual.read_bytes() != expected.read_bytes():
            mismatches.append(ch.path)

    if mismatches:
        joined = ", ".join(mismatches)
        raise CommandError(
            f"Replayed prompt tree does not match the reviewed result: {joined}"
        )


def apply_prompt_graph(repo: Path, result: RunResult) -> None:
    events = result.execution_events
    ensure_prompt_branches_available(repo, events)
    original_branch = get_current_branch(repo)
    temp_tip = run_cmd(
        ["git", "rev-parse", "HEAD"],
        cwd=result.working_dir,
    ).stdout.strip()
    run_cmd(
        [
            "git",
            "fetch",
            "--no-tags",
            str(result.working_dir),
            temp_tip,
        ],
        cwd=repo,
    )

    branch_stack: List[str] = []
    prompt_count = 0
    branch_count = 0
    for event in events:
        if event.event_type == "prompt":
            run_cmd(
                ["git", "cherry-pick", "--no-commit", event.commit_hash],
                cwd=repo,
            )
            current_branch = get_current_branch(repo)
            subject, body = make_commit_message(
                event.prompt,
                event.summary,
                branch=current_branch,
                temp_root=result.temp_root,
                summary_history=[event.summary],
            )
            commit(repo, subject, body, allow_empty=True)
            prompt_count += 1
            continue

        if event.event_type == "branch_start":
            branch_stack.append(get_current_branch(repo))
            run_cmd(["git", "checkout", "-b", event.branch_name], cwd=repo)
            branch_count += 1
            continue

        if event.event_type == "branch_end":
            if not branch_stack:
                raise CommandError("Prompt branch event stream is unbalanced.")
            child_branch = get_current_branch(repo)
            if child_branch != event.branch_name:
                raise CommandError(
                    "Prompt branch event stream ended a different branch than "
                    f"it started: {event.branch_name!r} != {child_branch!r}"
                )
            parent_branch = branch_stack.pop()
            run_cmd(["git", "checkout", parent_branch], cwd=repo)
            run_cmd(
                [
                    "git",
                    "merge",
                    "--no-ff",
                    child_branch,
                    "-m",
                    f"vybe merge: {child_branch}",
                ],
                cwd=repo,
            )
            continue

        raise CommandError(f"Unknown prompt execution event: {event.event_type!r}")

    if branch_stack:
        raise CommandError("Prompt branch event stream did not close every branch.")
    if get_current_branch(repo) != original_branch:
        raise CommandError("Prompt graph replay did not return to the original branch.")

    verify_replayed_tree(repo, result.changed_files)
    push_branch(repo, original_branch)
    ok(
        f"Applied {prompt_count} prompt commit(s) across {branch_count} "
        f"Git branch(es) on {original_branch}"
    )


def apply_result(repo: Path, result: RunResult) -> None:
    if result_has_prompt_branches(result):
        if branch_graph_can_be_replayed(repo, result):
            apply_prompt_graph(repo, result)
            return
        warn(
            "The prompt branch topology cannot be replayed because the result "
            "contains submodule or filtered-path changes; applying the reviewed "
            "net diff with the configured commit mode instead."
        )

    submodule_paths = get_submodule_paths(repo)
    changed_repo_paths: set[Path] = set()
    root_changed = False

    for ch in result.changed_files:
        repo_prefix, repo_relpath = split_repo_relpath(ch.path, submodule_paths)
        target_repo = repo / repo_prefix if repo_prefix else repo
        copy_changed_file_into_repo(target_repo, ch, repo_relpath)
        changed_repo_paths.add(target_repo.resolve())
        if not repo_prefix:
            root_changed = True

    submodule_repos = sorted(
        (path for path in changed_repo_paths if path != repo.resolve()),
        key=lambda path: relpath_posix(path, repo),
    )

    if COMMIT_MODE == "single":
        for submodule_repo in submodule_repos:
            submodule_branch = get_current_branch(submodule_repo)
            stage_all(submodule_repo)
            subject, body = make_commit_message(
                result.prompt,
                result.summary,
                branch=submodule_branch,
                temp_root=result.temp_root,
                summary_history=result.summary_history,
                changed_files=result.changed_files,
            )
            commit(submodule_repo, subject, body)
            push_branch(submodule_repo, submodule_branch)

        if root_changed or submodule_repos:
            branch = get_current_branch(repo)
            stage_all(repo)
            subject, body = make_commit_message(
                result.prompt,
                result.summary,
                branch=branch,
                temp_root=result.temp_root,
                summary_history=result.summary_history,
                changed_files=result.changed_files,
            )
            commit(repo, subject, body)
            push_branch(repo, branch)
            ok(f"Pushed {1 + len(submodule_repos)} commit(s) across root/submodule repos")
        return

    if submodule_repos:
        raise SystemExit("Submodule changes are only supported when COMMIT_MODE is 'single'.")

    branch = get_current_branch(repo)
    for idx, ch in enumerate(result.changed_files, start=1):
        info(f"[{idx}/{len(result.changed_files)}] Applying {ch.path}")
        stage_paths(repo, [ch.path])
        subject, body = make_commit_message(
            result.prompt,
            result.summary,
            branch=branch,
            temp_root=result.temp_root,
            summary_history=result.summary_history,
            ch=ch,
        )
        commit(repo, subject, body)
        push_branch(repo, branch)

    ok(f"Pushed {len(result.changed_files)} commit(s) to {GIT_REMOTE_NAME}/{branch}")


