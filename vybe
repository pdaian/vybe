def format_elapsed_time(elapsed: float) -> str:
    """Format elapsed time with five-unit thresholds and fixed 30-day months."""
    if elapsed <= 5 * 60:
        return f"{elapsed:.1f}s"

    remaining = int(elapsed)
    parts: List[str] = []
    for suffix, unit_seconds in (
        ("mo", 30 * 24 * 60 * 60),
        ("d", 24 * 60 * 60),
        ("h", 60 * 60),
        ("m", 60),
    ):
        if parts or elapsed > 5 * unit_seconds:
            value, remaining = divmod(remaining, unit_seconds)
            parts.append(f"{value}{suffix}")
    parts.append(f"{remaining}s")
    return " ".join(parts)


class LiveStatus:
    """
    Activity-aware, rotating ASCII animation with reduced terminal flicker.
    """

    def __init__(self, label: str = "Codex is thinking", mode: str = "radar") -> None:
        self.label = label
        self.mode = mode
        self.queue_count = 0
        self.queue_hint = prompt_action_hint()
        self._stop = threading.Event()
        self._pause = threading.Event()
        self._thread: Optional[threading.Thread] = None
        self._start_time = 0.0
        self._lock = threading.Lock()
        self._state_lock = threading.Lock()
        self._tick = 0
        self._rng = random.Random()
        self._last_lines: List[str] = []
        self._drawn_once = False
        self._full_screen = supports_ansi() and self.mode != "spinner"
        self._spinner_frames = ["|", "/", "-", "\\"]
        self._activity = "think"
        self._activity_updated_at = time.monotonic()
        self._scene = ANIMATION_SCENES[0]
        self._scene_started_at = 0.0
        self._feed_messages: List[ActivityFeedMessage] = []
        self._feed_scroll_offset = 0
        self._feed_inner_width = 0
        self._feed_inner_height = 0

    def start(self) -> None:
        self._start_time = time.monotonic()
        with self._state_lock:
            self._activity_updated_at = self._start_time
            self._select_scene(self._activity)
            self._scene_started_at = self._start_time
            self._feed_messages = [
                ActivityFeedMessage(0.0, "system", "connected; awaiting updates")
            ]
            self._feed_scroll_offset = 0
            self._feed_inner_width = 0
            self._feed_inner_height = 0
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def _move_up(self, n: int) -> None:
        if n > 0:
            sys.stdout.write(f"\033[{n}A")

    def _paint(self, lines: List[str]) -> None:
        if self._full_screen:
            if not self._drawn_once:
                self._drawn_once = True
                sys.stdout.write("\033[?1049h\033[?25l")
            size = get_terminal_size()
            frame = [truncate_ansi(line, size.columns) for line in lines[:size.lines]]
            frame.extend([""] * (size.lines - len(frame)))
            # Disable wrapping too: wide Unicode text can occupy extra cells.
            sys.stdout.write("\033[?7l\033[H")
            sys.stdout.write("\r\n".join("\033[2K" + line for line in frame))
            # No final newline: it would scroll a frame that fills the screen.
            sys.stdout.write("\033[?7h\r")
            sys.stdout.flush()
            self._last_lines = frame
            self._drawn_once = True
            return

        if not self._drawn_once:
            sys.stdout.write("\n".join(lines))
            sys.stdout.write("\n")
            sys.stdout.flush()
            self._last_lines = lines[:]
            self._drawn_once = True
            return

        self._move_up(len(self._last_lines))
        max_lines = max(len(self._last_lines), len(lines))
        padded_new = lines + [""] * (max_lines - len(lines))
        padded_old = self._last_lines + [""] * (max_lines - len(self._last_lines))

        for i, (_old, new) in enumerate(zip(padded_old, padded_new)):
            sys.stdout.write("\r\033[2K")
            sys.stdout.write(new)
            if i < max_lines - 1:
                sys.stdout.write("\n")

        sys.stdout.flush()
        self._last_lines = lines[:]

    def _final_clear(self) -> None:
        if not self._drawn_once:
            return

        if self._full_screen:
            sys.stdout.write("\033[H\033[2J\033[?7h\033[?25h\033[?1049l")
            sys.stdout.flush()
            self._last_lines = []
            self._drawn_once = False
            return

        self._move_up(len(self._last_lines))
        for i in range(len(self._last_lines)):
            sys.stdout.write("\r\033[2K")
            if i < len(self._last_lines) - 1:
                sys.stdout.write("\n")
        if self._last_lines:
            self._move_up(len(self._last_lines) - 1)
            sys.stdout.write("\r")
        sys.stdout.flush()

        self._last_lines = []
        self._drawn_once = False

    def _render_lines(self) -> List[str]:
        now = time.monotonic()
        elapsed = max(0.0, now - self._start_time)
        if not self._full_screen:
            return self._render_spinner(elapsed)

        with self._state_lock:
            activity = self._activity
            if now - self._activity_updated_at > ACTIVITY_TTL_SECONDS:
                activity = "think"
            if now - self._scene_started_at >= SCENE_ROTATION_SECONDS:
                self._select_scene(activity)
                self._scene_started_at = now
            scene = self._scene
            scene_age = now - self._scene_started_at
            queue_count = self.queue_count
            queue_hint = self.queue_hint

        return self._render_scene(
            elapsed,
            scene,
            activity,
            scene_age,
            queue_count,
            queue_hint,
        )

    def _render_spinner(self, elapsed: float) -> List[str]:
        frame = self._spinner_frames[self._tick % len(self._spinner_frames)]
        with self._state_lock:
            queue_count = self.queue_count
            queue_hint = self.queue_hint
        return [
            f"{DIM}{frame} {self.label}... {format_elapsed_time(elapsed):>6}  "
            f"pending={queue_count}  {queue_hint}{RESET}"
        ]

    def _select_scene(self, activity: str) -> None:
        matching = [
            scene for scene in ANIMATION_SCENES
            if activity in scene.activities
        ]
        pool = matching if matching and self._rng.random() < 0.82 else list(ANIMATION_SCENES)
        without_current = [scene for scene in pool if scene.name != self._scene.name]
        if without_current:
            pool = without_current
        different_renderer = [
            scene for scene in pool
            if scene.renderer != self._scene.renderer
        ]
        if different_renderer:
            pool = different_renderer
        self._scene = self._rng.choice(pool)

    @staticmethod
    def _new_canvas() -> List[List[str]]:
        return [[" " for _x in range(RADAR_WIDTH)] for _y in range(RADAR_HEIGHT)]

    @staticmethod
    def _plot(canvas: List[List[str]], x: int, y: int, ch: str) -> None:
        if 0 <= x < RADAR_WIDTH and 0 <= y < RADAR_HEIGHT:
            canvas[y][x] = ch

    @classmethod
    def _write_canvas(
        cls,
        canvas: List[List[str]],
        x: int,
        y: int,
        text: str,
    ) -> None:
        for offset, ch in enumerate(text):
            cls._plot(canvas, x + offset, y, ch)

    @classmethod
    def _draw_line(
        cls,
        canvas: List[List[str]],
        x0: int,
        y0: int,
        x1: int,
        y1: int,
        ch: str,
    ) -> None:
        dx = abs(x1 - x0)
        sx = 1 if x0 < x1 else -1
        dy = -abs(y1 - y0)
        sy = 1 if y0 < y1 else -1
        error = dx + dy
        while True:
            cls._plot(canvas, x0, y0, ch)
            if x0 == x1 and y0 == y1:
                break
            twice_error = 2 * error
            if twice_error >= dy:
                error += dy
                x0 += sx
            if twice_error <= dx:
                error += dx
                y0 += sy

    @staticmethod
    def _noise(seed: int, x: int, y: int, tick: int = 0) -> int:
        return (
            seed * 1103515245
            + x * 2654435761
            + y * 2246822519
            + tick * 3266489917
        ) & 0x7FFFFFFF

    def _scene_orbit(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        width = RADAR_WIDTH
        height = RADAR_HEIGHT
        cx = width // 2
        cy = height // 2
        radius_x = 13 + scene.seed % 6
        radius_y = 2 + scene.seed % 2
        for x in range(cx - radius_x, cx + radius_x + 1):
            ratio = (x - cx) / radius_x
            if abs(ratio) > 1:
                continue
            y_offset = int(round(radius_y * math.sqrt(max(0.0, 1.0 - ratio * ratio))))
            self._plot(canvas, x, cy - y_offset, ".")
            self._plot(canvas, x, cy + y_offset, ".")
        moon_x = cx + int(radius_x * math.cos(tick * 0.10 + scene.seed))
        moon_y = cy + int(radius_y * math.sin(tick * 0.10 + scene.seed))
        self._write_canvas(canvas, cx - 2, cy, "(@@@)")
        self._plot(canvas, moon_x, moon_y, "O")
        self._plot(canvas, (moon_x + 11) % width, (moon_y + 3) % height, "*")

    def _scene_wave(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        for band, base_y in enumerate((1, 3, 5)):
            for x in range(RADAR_WIDTH):
                phase = x * (0.22 + (scene.seed % 5) * 0.01)
                y = base_y + int(round(math.sin(phase + tick * 0.11 + band) * 0.7))
                self._plot(canvas, x, y, "~" if band != 1 else "=")
        for x in range(scene.seed % 9, RADAR_WIDTH, 11):
            self._plot(canvas, x, (tick // 2 + x) % RADAR_HEIGHT, "*")

    def _scene_rain(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        speed = 1 + scene.seed % 3
        for x in range(RADAR_WIDTH):
            if self._noise(scene.seed, x, 0) % 5 > 2:
                continue
            head = (tick * speed // 2 + self._noise(scene.seed, x, 1) % 19) % (RADAR_HEIGHT + 5)
            for trail, ch in enumerate(("*", "|", ":", ".")):
                self._plot(canvas, x, head - trail, ch)
        horizon = RADAR_HEIGHT - 1
        for x in range(0, RADAR_WIDTH, 2):
            self._plot(canvas, x, horizon, "_" if (x + tick) % 6 else "~")

    def _scene_garden(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        ground = RADAR_HEIGHT - 1
        self._write_canvas(canvas, 0, ground, "_" * RADAR_WIDTH)
        for index, x in enumerate(range(3 + scene.seed % 4, RADAR_WIDTH, 7)):
            target = 2 + self._noise(scene.seed, index, 0) % 4
            growth = min(target, 1 + (tick // 3 + index) % (target + 3))
            for step in range(growth):
                self._plot(canvas, x, ground - 1 - step, "|")
            top = ground - growth
            if growth >= target:
                self._write_canvas(canvas, x - 1, top, "\\*/")
            elif growth > 1:
                self._plot(canvas, x - 1, top + 1, "/")
                self._plot(canvas, x + 1, top + 1, "\\")
        cursor_x = (tick // 2 + scene.seed) % RADAR_WIDTH
        self._plot(canvas, cursor_x, ground, "+")

    def _scene_roots(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        hub_x = RADAR_WIDTH // 2 + (scene.seed % 5) - 2
        self._write_canvas(canvas, hub_x - 2, 0, "[o]")
        endpoints = (2, 10, 18, 27, 36, 41)
        for index, end_x in enumerate(endpoints):
            joint_x = (hub_x + end_x) // 2 + ((scene.seed + index) % 3) - 1
            self._draw_line(canvas, hub_x, 1, joint_x, 3, "/" if end_x < hub_x else "\\")
            self._draw_line(canvas, joint_x, 3, end_x, 6, "/" if end_x < joint_x else "\\")
            self._plot(canvas, joint_x, 3, "o")
            self._plot(canvas, end_x, 6, ".")
        pulse = endpoints[(tick // 3) % len(endpoints)]
        self._plot(canvas, pulse, 6, "*")

    def _scene_helix(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        center = RADAR_WIDTH // 2
        span = 14 + scene.seed % 5
        for y in range(RADAR_HEIGHT):
            phase = y * 0.95 + tick * 0.13 + scene.seed
            left = center + int(round(math.sin(phase) * span))
            right = center - int(round(math.sin(phase) * span))
            lo, hi = sorted((left, right))
            for x in range(lo + 1, hi):
                if (x + y + tick) % 3 == 0:
                    self._plot(canvas, x, y, "-")
            self._plot(canvas, left, y, "O")
            self._plot(canvas, right, y, "o")

    def _scene_scan(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        sweep = (tick + scene.seed) % (RADAR_WIDTH + 8) - 4
        for y in range(RADAR_HEIGHT):
            self._plot(canvas, sweep, y, "|")
            self._plot(canvas, sweep - 1, y, ":")
        self._write_canvas(canvas, 0, RADAR_HEIGHT - 1, "-" * RADAR_WIDTH)
        for index in range(8):
            x = self._noise(scene.seed, index, 0) % RADAR_WIDTH
            y = 1 + self._noise(scene.seed, index, 1) % (RADAR_HEIGHT - 2)
            distance = abs(x - sweep)
            self._plot(canvas, x, y, "O" if distance < 3 else ".")
        self._write_canvas(canvas, 1, 0, "[SCAN]")

    def _scene_forge(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        furnace_x = RADAR_WIDTH // 2 - 5
        self._write_canvas(canvas, furnace_x, RADAR_HEIGHT - 2, "/[CORE]\\")
        self._write_canvas(canvas, furnace_x - 2, RADAR_HEIGHT - 1, "==+====+==")
        for index in range(18):
            x_offset = self._noise(scene.seed, index, 0) % 21 - 10
            age = (tick + self._noise(scene.seed, index, 1) % 31) % 25
            y = RADAR_HEIGHT - 3 - age // 4
            x = RADAR_WIDTH // 2 + x_offset + int(math.sin(age + index))
            self._plot(canvas, x, y, "*" if age < 12 else ".")

    def _scene_circuit(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        nodes: List[Tuple[int, int]] = []
        for y in (1, 3, 5):
            shift = (scene.seed + y) % 6
            for x in range(shift, RADAR_WIDTH, 8):
                nodes.append((x, y))
                self._plot(canvas, x, y, "o")
                if x + 7 < RADAR_WIDTH:
                    self._write_canvas(canvas, x + 1, y, "-------")
        for x, y in nodes:
            if y < 5 and (x + scene.seed) % 3:
                self._plot(canvas, x, y + 1, "|")
        pulse_x, pulse_y = nodes[(tick // 2) % len(nodes)]
        self._plot(canvas, pulse_x, pulse_y, "*")

    def _scene_diff(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        lines = (
            "+ graft night_bus()",
            "- drop stale_signal",
            "+ root.patch(seed)",
            "@@ moon/garden @@",
            "+ return bloom",
            "- fossil_mode = true",
            "+ grid.feed(sun)",
            "+ tests: green",
        )
        start = (tick // 8 + scene.seed) % len(lines)
        for y in range(RADAR_HEIGHT):
            text = lines[(start + y) % len(lines)]
            self._write_canvas(canvas, 0, y, text[:RADAR_WIDTH])
        self._plot(canvas, min(len(lines[start]), RADAR_WIDTH - 1), 0, "_")

    def _scene_search(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        source_x = 3
        source_y = RADAR_HEIGHT // 2
        target_x = RADAR_WIDTH - 5
        target_y = 1 + (scene.seed % (RADAR_HEIGHT - 2))
        self._write_canvas(canvas, 0, source_y, "<O>")
        self._draw_line(canvas, source_x, source_y, target_x, target_y, ".")
        self._draw_line(canvas, source_x, source_y, target_x, RADAR_HEIGHT - 1, ":")
        beam_x = source_x + (tick * 2 + scene.seed) % (target_x - source_x)
        beam_ratio = (beam_x - source_x) / max(1, target_x - source_x)
        beam_y = int(round(source_y + (target_y - source_y) * beam_ratio))
        self._plot(canvas, beam_x, beam_y, "*")
        self._write_canvas(canvas, target_x - 1, target_y, "[X]")

    def _scene_verify(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        for y in (1, 3, 5):
            self._write_canvas(canvas, 1, y, "[o]---[o]---[o]---[o]---[o]")
        step = (tick // 3 + scene.seed) % 15
        row = (step // 5) * 2 + 1
        column = 2 + (step % 5) * 6
        self._plot(canvas, column, row, "*")
        heartbeat_x = (tick * 2) % RADAR_WIDTH
        self._plot(canvas, heartbeat_x, 0, "^")

    def _scene_code(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        source = (
            "def grow(light):",
            "  roots = map(signal)",
            "  if moon.is_up():",
            "    grid.feed(light)",
            "  return bloom",
            "",
            "# patching tomorrow",
        )
        reveal = 8 + (tick + scene.seed) % 34
        for y, line in enumerate(source):
            self._write_canvas(canvas, 1, y, line[:reveal])
        cursor_y = min(len(source) - 1, reveal // 7)
        cursor_x = min(RADAR_WIDTH - 1, 1 + len(source[cursor_y][:reveal]))
        self._plot(canvas, cursor_x, cursor_y, "_")

    def _scene_git(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        self._write_canvas(canvas, 1, 3, "o-----o-----o-----o-----o-----o")
        self._draw_line(canvas, 7, 3, 12, 1, "/")
        self._write_canvas(canvas, 12, 1, "o-----o-----o")
        self._draw_line(canvas, 24, 1, 31, 3, "\\")
        self._draw_line(canvas, 13, 3, 18, 5, "\\")
        self._write_canvas(canvas, 18, 5, "o-----o")
        self._draw_line(canvas, 24, 5, 31, 3, "/")
        pulse_x = 1 + ((tick + scene.seed) % 6) * 6
        self._plot(canvas, pulse_x, 3, "*")

    def _scene_comet(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        head_x = (tick + scene.seed) % (RADAR_WIDTH + 18) - 9
        head_y = 1 + int(2.4 + 2.0 * math.sin((tick + scene.seed) * 0.09))
        self._write_canvas(canvas, head_x - 2, head_y, "<O>")
        for trail in range(3, 20):
            y = head_y + int(math.sin(trail * 0.7 + tick * 0.1))
            self._plot(canvas, head_x - trail, y, "=" if trail < 9 else ".")
        for index in range(9):
            x = self._noise(scene.seed, index, 2) % RADAR_WIDTH
            y = self._noise(scene.seed, index, 3) % RADAR_HEIGHT
            self._plot(canvas, x, y, ".")

    def _scene_crystal(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        bases = (7, 18, 30, 38)
        for index, x in enumerate(bases):
            height = 2 + (scene.seed + index) % 4
            top = RADAR_HEIGHT - 1 - height
            self._draw_line(canvas, x, RADAR_HEIGHT - 1, x + 2, top, "/")
            self._draw_line(canvas, x + 4, RADAR_HEIGHT - 1, x + 2, top, "\\")
            self._plot(canvas, x + 2, top, "^")
            self._plot(canvas, x + 2, top + 2, "|" if index % 2 else ":")
        shimmer = bases[(tick // 4) % len(bases)] + 2
        self._plot(canvas, shimmer, 0, "*")
        self._write_canvas(canvas, 0, RADAR_HEIGHT - 1, "_" * RADAR_WIDTH)

    def _scene_skyline(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        ground = RADAR_HEIGHT - 1
        x = 0
        building = 0
        while x < RADAR_WIDTH:
            width = 4 + self._noise(scene.seed, building, 0) % 5
            height = 2 + self._noise(scene.seed, building, 1) % 4
            roof = ground - height
            self._write_canvas(canvas, x, roof, "_" * min(width, RADAR_WIDTH - x))
            for y in range(roof + 1, ground):
                self._plot(canvas, x, y, "|")
                self._plot(canvas, min(RADAR_WIDTH - 1, x + width - 1), y, "|")
                if y % 2 and x + 2 < RADAR_WIDTH:
                    self._plot(canvas, x + 2, y, "o" if (tick // 5 + building) % 2 else ".")
            self._plot(canvas, x + width // 2, roof - 1, "*")
            x += width + 1
            building += 1
        self._write_canvas(canvas, 0, ground, "=" * RADAR_WIDTH)

    def _scene_swarm(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        for index in range(26):
            phase = tick * 0.08 + index * 1.71 + scene.seed
            x = int((index * 13 + tick * (1 + index % 3) * 0.3 + scene.seed) % RADAR_WIDTH)
            y = int((RADAR_HEIGHT - 1) * (0.5 + 0.46 * math.sin(phase)))
            self._plot(canvas, x, y, "*" if index % 7 == 0 else ".")
        center_x = RADAR_WIDTH // 2 + int(math.sin(tick * 0.08) * 5)
        self._write_canvas(canvas, center_x - 2, RADAR_HEIGHT // 2, "[o]")

    def _scene_hourglass(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        center = RADAR_WIDTH // 2
        self._write_canvas(canvas, center - 8, 0, "+--------------+")
        self._write_canvas(canvas, center - 8, 6, "+--------------+")
        for y in range(1, 6):
            inset = y if y <= 3 else 6 - y
            self._plot(canvas, center - 8 + inset * 2, y, "\\")
            self._plot(canvas, center + 7 - inset * 2, y, "/")
        sand_level = (tick // 4 + scene.seed) % 6
        for y in range(1, 6):
            for x in range(center - 5, center + 5):
                if (self._noise(scene.seed, x, y) + sand_level) % 7 == 0:
                    self._plot(canvas, x, y, "." if y < 3 else ":")
        self._plot(canvas, center, 3, "*")

    def _scene_rings(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
        tick: int,
    ) -> None:
        cx = RADAR_WIDTH // 2
        cy = RADAR_HEIGHT // 2
        pulse = (tick // 3 + scene.seed) % 9
        for radius_x in (6, 12, 18):
            radius_y = max(1, radius_x // 6)
            for x in range(cx - radius_x, cx + radius_x + 1):
                ratio = (x - cx) / radius_x
                if abs(ratio) > 1:
                    continue
                y_offset = int(round(radius_y * math.sqrt(max(0.0, 1.0 - ratio * ratio))))
                ch = "*" if abs(radius_x // 2 - pulse) <= 1 else "."
                self._plot(canvas, x, cy - y_offset, ch)
                self._plot(canvas, x, cy + y_offset, ch)
        self._write_canvas(canvas, cx - 1, cy, "[O]")

    def _render_scene_canvas(self, scene: AnimationScene) -> List[List[str]]:
        canvas = self._new_canvas()
        renderer = getattr(self, f"_scene_{scene.renderer}")
        renderer(canvas, scene, self._tick)
        return canvas

    def _colorize_scene(
        self,
        canvas: List[List[str]],
        scene: AnimationScene,
    ) -> List[str]:
        body: List[str] = []
        bright = set("*@OoOX#^+")
        faint = set(".:")
        for y, row in enumerate(canvas):
            rendered: List[str] = []
            for x, ch in enumerate(row):
                if ch == " ":
                    rendered.append(ch)
                    continue
                color = scene.palette[
                    (x * 7 + y * 11 + self._tick // 4 + scene.seed)
                    % len(scene.palette)
                ]
                if ch in bright:
                    rendered.append(c(ch, BOLD + color))
                elif ch in faint:
                    rendered.append(c(ch, DIM + color))
                else:
                    rendered.append(c(ch, color))
            body.append("".join(rendered))
        return body

    def _render_scene(
        self,
        elapsed: float,
        scene: AnimationScene,
        activity: str,
        scene_age: float,
        queue_count: int,
        queue_hint: str,
    ) -> List[str]:
        height = get_terminal_size().lines
        # Reserve two header rows, two borders, and the keyboard controls.
        body_height = max(0, height - 5)
        canvas = self._render_scene_canvas(scene)
        scaled_canvas = [
            canvas[y * len(canvas) // body_height]
            for y in range(body_height)
        ]
        body = self._colorize_scene(scaled_canvas, scene)
        next_scene = max(0.0, SCENE_ROTATION_SECONDS - scene_age)
        title = (
            f"{BOLD}{scene.palette[0]} VYBE//{scene.name}{RESET} "
            f"{DIM}[{activity.upper()}] {self.label}{RESET}"
        )
        meta = (
            f"{DIM}model={get_codex_model()}  t={format_elapsed_time(elapsed):>6}  "
            f"next={next_scene:3.1f}s  reasoning={get_codex_reasoning_effort().label}{RESET}"
        )
        border_color = scene.palette[1 % len(scene.palette)]
        top = c("+" + "-" * RADAR_WIDTH + "+", DIM + border_color)
        bottom = c("+" + "-" * RADAR_WIDTH + "+", DIM + border_color)
        rendered = [title, meta, top]
        for line in body:
            rendered.append(c("|", DIM + border_color) + line + c("|", DIM + border_color))
        rendered.append(bottom)
        rendered = rendered[:height - 1]
        rendered.append(c(f" pending={queue_count} :: {queue_hint} ", DIM))
        return self._add_activity_sidebar(rendered)

    @staticmethod
    def _wrap_activity_log(
        feed_messages: Sequence[ActivityFeedMessage],
        inner_width: int,
    ) -> List[str]:
        log_lines: List[str] = []
        for message in feed_messages:
            minutes, seconds = divmod(int(message.elapsed), 60)
            timestamp = f"{minutes:02d}:{seconds:02d}"
            prefix = f"[{timestamp}] <{message.nick}> "
            wrapper = textwrap.TextWrapper(
                width=max(1, inner_width),
                initial_indent=prefix,
                subsequent_indent=" " * len(prefix),
                break_long_words=True,
                break_on_hyphens=False,
            )
            log_lines.extend(wrapper.wrap(message.text) or [prefix.rstrip()])
        return log_lines

    def _add_activity_sidebar(self, left_lines: List[str]) -> List[str]:
        left_width = max((ansi_visible_length(line) for line in left_lines), default=0)
        available = get_terminal_columns() - left_width - 2
        if available < ACTIVITY_SIDEBAR_MIN_WIDTH or len(left_lines) < 3:
            with self._state_lock:
                self._feed_inner_height = 0
            return left_lines

        panel_width = min(ACTIVITY_SIDEBAR_MAX_WIDTH, available)
        panel_height = len(left_lines)
        inner_width = panel_width - 2
        inner_height = panel_height - 2
        title = " #codex-activity "
        top = "+" + title + "-" * max(0, inner_width - len(title)) + "+"

        with self._state_lock:
            self._feed_inner_width = inner_width
            self._feed_inner_height = inner_height
            log_lines = self._wrap_activity_log(self._feed_messages, inner_width)
            self._feed_scroll_offset = min(
                self._feed_scroll_offset,
                max(0, len(log_lines) - inner_height),
            )
            scroll_offset = self._feed_scroll_offset
            end = len(log_lines) - scroll_offset
            visible_log = log_lines[max(0, end - inner_height):end]

        visible_log = [""] * (inner_height - len(visible_log)) + visible_log
        position = f"{scroll_offset} up" if scroll_offset else "live"
        hint = f" Up/Down scroll | {position} "
        bottom = "+" + hint[:inner_width].ljust(inner_width, "-") + "+"
        border_style = DIM + CYAN
        sidebar = [c(top, border_style)]
        for line in visible_log:
            sidebar.append(
                c("|", border_style)
                + c(line.ljust(inner_width), DIM)
                + c("|", border_style)
            )
        sidebar.append(c(bottom, border_style))

        combined: List[str] = []
        for left, right in zip(left_lines, sidebar):
            padding = " " * max(0, left_width - ansi_visible_length(left))
            combined.append(left + padding + "  " + right)
        return combined

    def _run(self) -> None:
        try:
            while not self._stop.is_set():
                if self._pause.is_set():
                    time.sleep(0.02)
                    continue

                lines = self._render_lines()
                with self._lock:
                    if self._pause.is_set() or self._stop.is_set():
                        continue
                    self._paint(lines)

                self._tick += 1
                time.sleep(RADAR_INTERVAL if self.mode == "radar" else SPINNER_INTERVAL)
        finally:
            with self._lock:
                self._final_clear()

    def pause_for_output(self) -> None:
        self._pause.set()
        with self._lock:
            self._final_clear()

    def resume(self) -> None:
        self._pause.clear()

    def stop(self) -> None:
        self._stop.set()
        if self._thread:
            self._thread.join(timeout=1.0)

    def set_queue_status(self, queue_count: int, hint: Optional[str] = None) -> None:
        with self._state_lock:
            self.queue_count = queue_count
            if hint is not None:
                self.queue_hint = hint

    def scroll_activity(self, lines: int) -> None:
        """Scroll up by a number of wrapped lines; zero offset follows updates."""
        with self._state_lock:
            if not self._feed_inner_height:
                return
            log_lines = self._wrap_activity_log(
                self._feed_messages, self._feed_inner_width,
            )
            max_offset = max(0, len(log_lines) - self._feed_inner_height)
            self._feed_scroll_offset = max(
                0, min(max_offset, self._feed_scroll_offset + lines),
            )

    def observe_output(self, output: str) -> None:
        activity: Optional[str] = None
        for line in output.splitlines() or [output]:
            inferred = infer_codex_activity(line)
            if inferred is not None:
                activity = inferred
        messages = extract_public_activity_messages(output)
        if activity is None and not messages:
            return
        with self._state_lock:
            previous_activity = self._activity
            if activity is not None:
                self._activity = activity
                self._activity_updated_at = time.monotonic()

            if not messages and activity is not None and activity != previous_activity:
                messages = [("*", describe_codex_activity(activity))]

            elapsed = max(0.0, time.monotonic() - self._start_time)
            for nick, text in messages:
                clean_nick = sanitize_activity_text(nick, max_chars=12) or "*"
                clean_text = sanitize_activity_text(text)
                if not clean_text:
                    continue
                candidate = ActivityFeedMessage(elapsed, clean_nick, clean_text)
                if (
                    self._feed_messages
                    and self._feed_messages[-1].nick == candidate.nick
                    and self._feed_messages[-1].text == candidate.text
                ):
                    continue
                self._feed_messages.append(candidate)
                if self._feed_scroll_offset:
                    self._feed_scroll_offset += len(
                        self._wrap_activity_log([candidate], self._feed_inner_width)
                    )
            if len(self._feed_messages) > ACTIVITY_FEED_LIMIT:
                self._feed_messages = self._feed_messages[-ACTIVITY_FEED_LIMIT:]


