def detect_codex_support() -> CodexSupport:
    exec_proc = run_cmd([CODEX_BINARY, "exec", "--help"], check=False, capture=True)
    root_proc = run_cmd([CODEX_BINARY, "--help"], check=False, capture=True)
    exec_text = (exec_proc.stdout or "") + "\n" + (exec_proc.stderr or "")
    root_text = (root_proc.stdout or "") + "\n" + (root_proc.stderr or "")
    return CodexSupport(
        has_json="--json" in exec_text,
        has_output_last_message="--output-last-message" in exec_text,
        has_search="--search" in root_text,
    )


def build_codex_command(
    support: CodexSupport,
    options: PromptOptions,
    summary_file: Path,
) -> List[str]:
    codex_mode = get_codex_mode()
    codex_model = get_codex_model()
    reasoning_effort = get_codex_reasoning_effort()
    cmd = [CODEX_BINARY]

    if (CODEX_ENABLE_WEB_SEARCH or options.enable_search) and support.has_search:
        cmd.append("--search")

    cmd += [
        "exec", "--skip-git-repo-check",
        "--model", codex_model,
        "--sandbox", CODEX_SANDBOX,
        "--config", f"model_reasoning_effort={reasoning_effort.codex_value!r}",
        "--config", f"model_verbosity={get_codex_verbosity()!r}",
        "--config", f"background_terminal_max_timeout={CODEX_BACKGROUND_TERMINAL_MAX_TIMEOUT_MS}",
    ]

    if codex_mode == "fast":
        cmd += ["--enable", "fast_mode", "--config", "service_tier='fast'"]
    else:
        cmd += ["--disable", "fast_mode", "--config", "service_tier='default'"]

    if CODEX_USE_JSON_IF_AVAILABLE and support.has_json:
        cmd.append("--json")

    if support.has_output_last_message:
        cmd += ["--output-last-message", str(summary_file)]

    full_prompt = (
        options.prompt_text.strip()
        + "\n\n"
        + build_prompt_suffix(plan_mode=options.plan_mode)
        + "\n"
    )
    cmd.append(full_prompt)
    return cmd


