def ensure_parent(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)


def split_repo_relpath(relpath: str, submodule_paths: Sequence[str]) -> Tuple[str, str]:
    relpath = relpath.replace("\\", "/")
    for submodule_path in sorted(submodule_paths, key=len, reverse=True):
        prefix = f"{submodule_path}/"
        if relpath == submodule_path:
            return submodule_path, "."
        if relpath.startswith(prefix):
            return submodule_path, relpath[len(prefix):]
    return "", relpath


def copy_changed_file_into_repo(repo: Path, ch: ChangedFile, repo_relpath: Optional[str] = None) -> None:
    target_relpath = repo_relpath or ch.path
    dest = (repo.resolve() / target_relpath).resolve()

    if ch.status == "D":
        if dest.exists():
            if dest.is_dir():
                shutil.rmtree(dest)
            else:
                dest.unlink()
        return

    assert ch.new_abs is not None

    if dest.exists():
        dest_is_dir = dest.is_dir()
        new_is_dir = ch.new_abs.is_dir()
        if dest_is_dir != new_is_dir:
            if dest_is_dir:
                shutil.rmtree(dest)
            else:
                dest.unlink()

    if ch.new_abs.is_dir():
        dest.mkdir(parents=True, exist_ok=True)
        return

    ensure_parent(dest)
    shutil.copy2(ch.new_abs.resolve(), dest)


