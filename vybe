def get_codex_reasoning_effort() -> ReasoningEffort:
    raw = os.environ.get(CODEX_REASONING_ENV_VAR, CODEX_REASONING_EFFORT).strip().lower()
    model = get_codex_model()
    max_models = ("gpt-5.6", "gpt-6-astra", "gpt-6.1-sol", "gpt-6-sol", "gpt-6-luna")
    supports_max = any(model == name or model.startswith(name + "-") for name in max_models)
    max_value = "max" if supports_max else "xhigh"
    aliases = {
        "ultra": ReasoningEffort("ultra", "ultra"),
        "max": ReasoningEffort("max", max_value),
        "extra": ReasoningEffort("max", max_value),
        "xhigh": ReasoningEffort("xhigh", "xhigh"),
        "high": ReasoningEffort("high", "high"),
        "medium": ReasoningEffort("medium", "medium"),
        "normal": ReasoningEffort("medium", "medium"),
        "low": ReasoningEffort("low", "low"),
        "fast": ReasoningEffort("low", "low"),
    }
    effort = aliases.get(raw)
    if effort is None:
        raise SystemExit(
            f"Invalid {CODEX_REASONING_ENV_VAR}={raw!r}. "
            "Use low, medium, high, xhigh, extra, max, or ultra."
        )
    return effort


def get_codex_verbosity() -> str:
