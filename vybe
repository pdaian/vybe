def extract_summary_from_stream(text: str) -> str:
    blocks = [b.strip() for b in re.split(r"\n\s*\n", text) if b.strip()]
    if not blocks:
        return "(No summary captured.)"

    for block in reversed(blocks):
        stripped = block.strip()
        if stripped.startswith("{") and stripped.endswith("}"):
            continue
        return stripped

    return blocks[-1]


def normalize_summary_paths(summary: str, working_dir: Path) -> str:
    base = working_dir.resolve().as_posix().rstrip("/")
    if not base:
        return summary

    def replace_abs_path(match: re.Match[str]) -> str:
        suffix = (match.group(1) or "").lstrip("/")
        return suffix or "."

    pattern = re.compile(rf"{re.escape(base)}(?:/([^\s)\]>`]+))?")
    return pattern.sub(replace_abs_path, summary)


def prompt_action_label(kind: str) -> str:
    return {
        PROMPT_KIND_STACK: "stack",
        PROMPT_KIND_REFINE: "refine",
        PROMPT_KIND_BRANCH: "branch",
    }.get(kind, kind)


def prompt_action_hint() -> str:
    return "[Enter] stack  [R] refine next  [B] branch"


def queued_action_status(actions: Sequence[PromptAction]) -> str:
    counts = {
        PROMPT_KIND_STACK: 0,
        PROMPT_KIND_REFINE: 0,
        PROMPT_KIND_BRANCH: 0,
    }
    for action in actions:
        if action.kind in counts:
            counts[action.kind] += 1
    return (
        f"pending={len(actions)} "
        f"(stack={counts[PROMPT_KIND_STACK]}, "
        f"refine={counts[PROMPT_KIND_REFINE]}, "
        f"branch={counts[PROMPT_KIND_BRANCH]})"
    )


def maybe_show_queue_prompt(state: PromptQueueState, kind: str) -> None:
    if state.prompt_visible or not sys.stdin.isatty():
        return
    if kind not in {PROMPT_KIND_STACK, PROMPT_KIND_REFINE, PROMPT_KIND_BRANCH}:
        return
    state.capture_kind = kind
    label = prompt_action_label(kind)
    print(f"\n[{queued_action_status(state.actions)}]")
    print(f"{label}> (finish with 4 blank lines)")
    state.prompt_visible = True
    state.capture_active = True


def finish_queued_prompt(state: PromptQueueState) -> bool:
    lines = list(state.lines)
    while lines and lines[-1] == "":
        lines.pop()
    prompt = "\n".join(lines).strip()
    kind = state.capture_kind
    state.lines.clear()
    state.blank_streak = 0
    state.prompt_visible = False
    state.capture_active = False
    state.capture_kind = ""
    if not prompt:
        return False
    state.actions.append(PromptAction(kind=kind, prompt=prompt))
    label = prompt_action_label(kind)
    matching_count = sum(1 for action in state.actions if action.kind == kind)
    print(f"[queued {label} prompt #{matching_count}]")
    return True


def begin_queue_capture(state: PromptQueueState, kind: str) -> None:
    if state.capture_active:
        return
    maybe_show_queue_prompt(state, kind)


def consume_queue_input(state: PromptQueueState) -> bool:
    raw = sys.stdin.readline()
    if raw == "":
        return False

    line = raw.rstrip("\r\n")
    state.lines.append(line)
    if line == "":
        state.blank_streak += 1
    else:
        state.blank_streak = 0

    if state.blank_streak >= 4:
        state.lines = state.lines[:-4]
        return finish_queued_prompt(state)
    return False


def finalize_queued_input(state: PromptQueueState) -> None:
    if state.lines:
        finish_queued_prompt(state)


class QueueInputController:
    def __init__(self, fd: int) -> None:
        self.fd = fd
        self._attrs: Optional[List[object]] = None
        self._cbreak_enabled = False
        self._escape_sequence = ""

    def enable_cbreak(self) -> None:
        if self._cbreak_enabled:
            return
        if self._attrs is None:
            self._attrs = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)
        self._cbreak_enabled = True

    def disable_cbreak(self) -> None:
        self._escape_sequence = ""
        if not self._cbreak_enabled or self._attrs is None:
            return
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self._attrs)
        self._cbreak_enabled = False

    def read_key(self) -> str:
        try:
            data = os.read(self.fd, 1)
        except OSError:
            return ""
        key = data.decode(errors="ignore")
        if not key:
            return ""
        if key == "\033":
            self._escape_sequence = key
            return ""
        if self._escape_sequence == "\033" and key not in {"[", "O"}:
            self._escape_sequence = ""
            return key
        if self._escape_sequence:
            self._escape_sequence += key
            if self._escape_sequence in {"\033[", "\033O", "\033[["}:
                return ""
            # Keep partial terminal sequences across reads, including parameters.
            if (
                self._escape_sequence.startswith(("\033[", "\033O"))
                and "\x20" <= key <= "\x3f"
            ):
                return ""
            sequence = self._escape_sequence
            self._escape_sequence = ""
            return {
                "\033[A": "up", "\033[B": "down",
                "\033OA": "up", "\033OB": "down",
            }.get(sequence, "")
        return key


def can_queue_input_during_run() -> bool:
    if not sys.stdin.isatty():
        return False
    try:
        sys.stdin.fileno()
    except (AttributeError, OSError, ValueError):
        return False
    return os.name == "posix"


def run_codex(
    support: CodexSupport,
    working_dir: Path,
    prompt_text: str,
) -> Tuple[str, str, List[PromptAction]]:
    options = parse_prompt_options(prompt_text)
    if not options.prompt_text:
        raise CommandError("Prompt is empty after removing slash commands.")

    summary_file = (working_dir.parent / "last_message.txt").resolve()
    summary_file.unlink(missing_ok=True)
    cmd = build_codex_command(support, options, summary_file)

    banner("RUNNING CODEX")
    print("Command:")
    print(" ".join(shlex.quote(x) for x in cmd[:-1]))
    print("\nPrompt:")
    print(wrap_for_display(options.prompt_text, min(80, get_terminal_columns())))
    print("\nOutput:")
    print("-" * 88)

    proc = subprocess.Popen(
        cmd,
        cwd=str(working_dir),
        env=build_codex_env(),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
    )

    queue_state = PromptQueueState()
    queue_enabled = can_queue_input_during_run()
    show_stream = SHOW_FULL_CODEX_STREAM and not queue_enabled

    live: Optional[LiveStatus] = None
    queue_input: Optional[QueueInputController] = None
    live = LiveStatus("Codex is thinking", mode="radar")
    if queue_enabled:
        print(
            "Live prompt controls: Enter stacks, R refines next, "
            "and B starts a Git-backed branch."
        )
        live.set_queue_status(0, prompt_action_hint())
    live.start()

    out_lines: List[str] = []
    assert proc.stdout is not None
    rc = 0

    try:
        stdout_fd = proc.stdout.fileno()
        stdin_fd = sys.stdin.fileno() if queue_enabled else None
        if stdin_fd is not None:
            queue_input = QueueInputController(stdin_fd)
            queue_input.enable_cbreak()

        while True:
            read_fds = [stdout_fd]
            if queue_enabled and stdin_fd is not None:
                read_fds.append(stdin_fd)

            ready, _, _ = select.select(read_fds, [], [], 0.1)
            if stdin_fd is not None and stdin_fd in ready:
                if queue_state.capture_active:
                    was_capturing = queue_state.capture_active
                    consume_queue_input(queue_state)
                    if was_capturing and not queue_state.capture_active:
                        if live is not None:
                            live.set_queue_status(
                                len(queue_state.actions),
                                prompt_action_hint(),
                            )
                            live.resume()
                        if queue_input is not None:
                            queue_input.enable_cbreak()
                else:
                    assert queue_input is not None
                    key = queue_input.read_key()
                    if key in {"\n", "\r"}:
                        capture_kind = PROMPT_KIND_STACK
                    elif key in {"r", "R"}:
                        capture_kind = PROMPT_KIND_REFINE
                    elif key in {"b", "B"}:
                        capture_kind = PROMPT_KIND_BRANCH
                    else:
                        capture_kind = ""

                    if key in {"up", "down"}:
                        if live is not None:
                            live.scroll_activity(1 if key == "up" else -1)
                    elif capture_kind:
                        queue_input.disable_cbreak()
                        if live is not None:
                            live.pause_for_output()
                        begin_queue_capture(queue_state, capture_kind)
                    elif key:
                        sys.stdout.write("\a")
                        sys.stdout.flush()

            if stdout_fd in ready:
                line = proc.stdout.readline()
                if line:
                    out_lines.append(line)
                    if live is not None:
                        live.observe_output(line)
                    if show_stream:
                        if live is not None:
                            live.pause_for_output()
                        sys.stdout.write(line)
                        sys.stdout.flush()
                        if live is not None:
                            live.resume()

            if proc.poll() is not None:
                tail = proc.stdout.read()
                if tail:
                    out_lines.append(tail)
                    if live is not None:
                        live.observe_output(tail)
                    if show_stream:
                        if live is not None:
                            live.pause_for_output()
                        sys.stdout.write(tail)
                        sys.stdout.flush()
                        if live is not None:
                            live.resume()
                rc = proc.returncode
                break
    finally:
        if queue_input is not None:
            queue_input.disable_cbreak()
        if live is not None:
            live.stop()

    print("-" * 88)
    if queue_enabled:
        finalize_queued_input(queue_state)

    combined = "".join(out_lines)
    if rc != 0:
        raise CommandError(f"Codex failed with exit code {rc}\n{combined}")

    if summary_file.exists():
        summary = summary_file.read_text(encoding="utf-8", errors="replace").strip()
    else:
        summary = extract_summary_from_stream(combined)

    if not summary:
        summary = "(No summary captured.)"

    summary = normalize_summary_paths(summary, working_dir)
    return summary, combined, queue_state.actions


def prompt_for_execution(action: PromptAction) -> str:
    prompt = action.prompt.strip()
    if action.kind != PROMPT_KIND_REFINE:
        return prompt
    lines = prompt.splitlines()
    directive_count = 0
    while (
        directive_count < len(lines)
        and lines[directive_count].strip().lower() in {"/search", "/plan"}
    ):
        directive_count += 1
    directives = lines[:directive_count]
    refinement = "\n".join(lines[directive_count:]).strip()
    body = (
        "Refine the active task with the correction or constraint below. "
        "Reconcile it with the work already present in the workspace, revise "
        "existing changes as needed, and verify the combined result before "
        "continuing.\n\n"
        f"{refinement}"
    )
    return "\n".join(directives + [body]).strip()


def prompt_commit_subject(kind: str, prompt: str) -> str:
    first_line = next(
        (line.strip() for line in prompt.splitlines() if line.strip()),
        "prompt",
    )
    first_line = re.sub(r"\s+", " ", first_line)
    if len(first_line) > 58:
        first_line = first_line[:55].rstrip() + "..."
    return f"vybe {prompt_action_label(kind)}: {first_line}"


def checkpoint_prompt(
    working_dir: Path,
    *,
    base_commit: str,
    kind: str,
    prompt: str,
    summary: str,
    subject_prompt: Optional[str] = None,
) -> str:
    git_env = build_temp_git_env()
    run_cmd(
        ["git", "reset", "--soft", base_commit],
        cwd=working_dir,
        env=git_env,
    )
    run_cmd(["git", "add", "-A"], cwd=working_dir, env=git_env)
    subject = prompt_commit_subject(kind, subject_prompt or prompt)
    body = normalize_summary_text(summary)
    run_cmd(
        ["git", "commit", "--allow-empty", "-m", subject, "-m", body],
        cwd=working_dir,
        env=git_env,
    )
    return run_cmd(["git", "rev-parse", "HEAD"], cwd=working_dir).stdout.strip()


def branch_slug(prompt: str) -> str:
    first_line = next(
        (line.strip().lower() for line in prompt.splitlines() if line.strip()),
        "work",
    )
    slug = re.sub(r"[^a-z0-9]+", "-", first_line).strip("-")
    return (slug[:28].rstrip("-") or "work")


def next_prompt_branch_name(trace: PromptExecutionTrace, prompt: str) -> str:
    trace.branch_counter += 1
    session_tag = re.sub(r"[^A-Za-z0-9._-]+", "-", trace.session_tag).strip("-")
    return (
        f"vybe/{session_tag or 'session'}/"
        f"b{trace.branch_counter:03d}-{branch_slug(prompt)}"
    )


def execute_prompt_branch(
    support: CodexSupport,
    working_dir: Path,
    action: PromptAction,
    trace: PromptExecutionTrace,
) -> None:
    parent_branch = get_current_branch(working_dir)
    branch_name = next_prompt_branch_name(trace, action.prompt)
    trace.events.append(
        PromptExecutionEvent(
            event_type="branch_start",
            branch_name=branch_name,
            parent_branch=parent_branch,
        )
    )
    run_cmd(
        ["git", "checkout", "-b", branch_name],
        cwd=working_dir,
        env=build_temp_git_env(),
    )
    execute_prompt_action(support, working_dir, action, trace)
    run_cmd(
        ["git", "checkout", parent_branch],
        cwd=working_dir,
        env=build_temp_git_env(),
    )
    run_cmd(
        [
            "git",
            "merge",
            "--no-ff",
            branch_name,
            "-m",
            f"vybe merge: {branch_name}",
        ],
        cwd=working_dir,
        env=build_temp_git_env(),
    )
    trace.events.append(
        PromptExecutionEvent(
            event_type="branch_end",
            branch_name=branch_name,
            parent_branch=parent_branch,
        )
    )


def execute_prompt_action(
    support: CodexSupport,
    working_dir: Path,
    action: PromptAction,
    trace: PromptExecutionTrace,
) -> None:
    if action.kind not in PROMPT_KINDS:
        raise CommandError(f"Unknown prompt action kind: {action.kind!r}")

    effective_prompt = prompt_for_execution(action)
    starting_branch = get_current_branch(working_dir)
    base_commit = run_cmd(
        ["git", "rev-parse", "HEAD"],
        cwd=working_dir,
    ).stdout.strip()
    summary, _combined, queued_actions = run_codex(
        support,
        working_dir,
        effective_prompt,
    )
    ending_branch = get_current_branch(working_dir)
    if ending_branch != starting_branch:
        raise CommandError(
            "Codex changed the temporary Git branch during a managed prompt "
            f"({starting_branch!r} -> {ending_branch!r}). Ask it to edit and "
            "validate files without switching branches; use B for vybe-managed "
            "branch workstreams."
        )
    commit_hash = checkpoint_prompt(
        working_dir,
        base_commit=base_commit,
        kind=action.kind,
        prompt=effective_prompt,
        subject_prompt=action.prompt,
        summary=summary,
    )
    trace.prompt_history.append(effective_prompt)
    trace.summary_history.append(summary)
    trace.events.append(
        PromptExecutionEvent(
            event_type="prompt",
            prompt_kind=action.kind,
            prompt=effective_prompt,
            summary=summary,
            commit_hash=commit_hash,
        )
    )

    refinements = [
        queued for queued in queued_actions if queued.kind == PROMPT_KIND_REFINE
    ]
    branches = [
        queued for queued in queued_actions if queued.kind == PROMPT_KIND_BRANCH
    ]
    stacks = [
        queued for queued in queued_actions if queued.kind == PROMPT_KIND_STACK
    ]

    for refinement in refinements:
        execute_prompt_action(support, working_dir, refinement, trace)
    for branch in branches:
        execute_prompt_branch(support, working_dir, branch, trace)
    for stacked in stacks:
        execute_prompt_action(support, working_dir, stacked, trace)


def run_prompt_chain(
    support: CodexSupport,
    working_dir: Path,
    prompt_text: str,
    trace: Optional[PromptExecutionTrace] = None,
    initial_kind: str = PROMPT_KIND_ROOT,
) -> PromptExecutionTrace:
    if trace is None:
        trace = PromptExecutionTrace(session_tag=working_dir.parent.name)
    execute_prompt_action(
        support,
        working_dir,
        PromptAction(kind=initial_kind, prompt=prompt_text),
        trace,
    )
    return trace


