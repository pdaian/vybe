def get_codex_mode() -> str:
    raw = os.environ.get(CODEX_MODE_ENV_VAR, "slow").strip().lower()
    aliases = {
        "2x": "fast",
        "fast": "fast",
        "normal": "slow",
        "slow": "slow",
    }
    mode = aliases.get(raw)
    if mode is None:
        raise SystemExit(
            f"Invalid {CODEX_MODE_ENV_VAR}={raw!r}. Use fast, 2x, slow, or normal."
        )
    return mode


def get_codex_model() -> str:
