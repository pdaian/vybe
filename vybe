def c(text: str, color: str) -> str:
    return f"{color}{text}{RESET}"


def art_color(seed: int, palette: Sequence[str] = ART_COLORS) -> str:
    return palette[seed % len(palette)]


def art_noise_glyph(rng: random.Random) -> str:
    roll = rng.random()
    if roll < 0.72:
        return rng.choice(ART_SPARK_GLYPHS)
    if roll < 0.88:
        return rng.choice(ART_ALNUM_GLYPHS)
    if roll < 0.97:
        return rng.choice(ART_SYMBOL_GLYPHS)
    return rng.choice(ART_EMOJI_GLYPHS)


def infer_codex_activity(output: str) -> Optional[str]:
    """
    Infer a broad activity from human or JSONL Codex output.

    This is deliberately heuristic: animation choice is ambient UI, so unknown
    and future event formats simply leave the current activity unchanged.
    """
    text = output.lower()
    activity_patterns = (
        (
            "verify",
            (
                "pytest", "unittest", "npm test", "pnpm test", "yarn test",
                "cargo test", "go test", "ruff", "mypy", "typecheck",
                "type-check", "lint", "test suite", "validation",
            ),
        ),
        (
            "git",
            (
                "git status", "git diff", "git log", "git show",
                "git commit", "git branch", "git merge",
            ),
        ),
        (
            "write",
            (
                "apply_patch", "file_change", "write_file", "create_file",
                "edit_file", "patch applied", "updated file",
            ),
        ),
        (
            "inspect",
            (
                "read_file", "list_files", "\"rg ", "\"sed ", "\"cat ",
                "\"head ", "\"tail ", "\"find ", "\"ls ",
                "'rg ", "'sed ", "'cat ", "'head ", "'tail ", "'find ",
                "'ls ",
            ),
        ),
        (
            "search",
            (
                "web_search", "search_query", "image_query", "browser.",
                "\"search\"", "searched the web",
            ),
        ),
        (
            "wait",
            (
                "wait_agent", "\"wait\"", "waiting for", "still running",
                "yield_time",
            ),
        ),
        (
            "execute",
            (
                "command_execution", "exec_command", "write_stdin",
                "shell_command", "terminal.",
            ),
        ),
        (
            "think",
            (
                "\"reasoning\"", "\"analysis\"", "update_plan",
                "item.started", "turn.started",
            ),
        ),
    )
    for activity, patterns in activity_patterns:
        if any(pattern in text for pattern in patterns):
            return activity
    return None


def describe_codex_activity(activity: str) -> str:
    return {
        "execute": "running a workspace command",
        "git": "checking repository state",
        "inspect": "inspecting the workspace",
        "search": "searching for context",
        "verify": "running validation",
        "write": "preparing workspace changes",
        "wait": "waiting on background work",
        "think": "working through the task",
    }.get(activity, "working through the task")


def sanitize_activity_text(value: object, max_chars: int = 360) -> str:
    """Return compact, terminal-safe text suitable for the public activity log."""
    if not isinstance(value, str):
        return ""
    without_controls = re.sub(r"[\x00-\x1f\x7f-\x9f]+", " ", value)
    compact = re.sub(r"\s+", " ", without_controls).strip()
    if len(compact) <= max_chars:
        return compact
    return compact[: max_chars - 3].rstrip() + "..."


def activity_item_text(item: Dict[str, object]) -> str:
    for key in ("text", "summary", "message"):
        text = sanitize_activity_text(item.get(key))
        if text:
            return text

    content = item.get("content")
    if isinstance(content, list):
        parts: List[str] = []
        for part in content:
            if isinstance(part, dict):
                text = sanitize_activity_text(part.get("text"))
                if text:
                    parts.append(text)
        return sanitize_activity_text(" ".join(parts))
    return ""


def extract_public_activity_messages(output: str) -> List[Tuple[str, str]]:
    """
    Extract user-visible Codex summaries and coarse tool updates from JSONL.

    Commands and tool arguments are deliberately not included: the sidebar is
    a concise activity log, not a raw transcript or hidden chain-of-thought.
    """
    messages: List[Tuple[str, str]] = []
    for line in output.splitlines():
        try:
            event = json.loads(line)
        except (json.JSONDecodeError, TypeError):
            continue
        if not isinstance(event, dict):
            continue

        event_type = event.get("type")
        item = event.get("item")
        if not isinstance(event_type, str) or not isinstance(item, dict):
            continue

        item_type = item.get("type")
        if item_type in {"reasoning", "agent_message", "plan", "plan_update"}:
            text = activity_item_text(item)
            if text:
                messages.append(("codex", text))
            continue

        if event_type == "item.completed" and item_type == "todo_list":
            messages.append(("*", "plan updated"))
            continue

        tool_item_types = {
            "command_execution",
            "file_change",
            "mcp_tool_call",
            "web_search",
        }
        if event_type == "item.started" and item_type in tool_item_types:
            serialized = json.dumps(item, ensure_ascii=False)
            activity = infer_codex_activity(serialized) or "execute"
            messages.append(("*", describe_codex_activity(activity)))
        elif event_type == "item.completed" and item_type == "file_change":
            messages.append(("*", "workspace files updated"))

    return messages


def ansi_visible_length(text: str) -> int:
    return len(re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text))


def truncate_ansi(text: str, width: int) -> str:
    if ansi_visible_length(text) <= width:
        return text
    parts: List[str] = []
    remaining = max(0, width)
    for part in re.split(r"(\x1b\[[0-?]*[ -/]*[@-~])", text):
        if part.startswith("\033["):
            parts.append(part)
        else:
            parts.append(part[:remaining])
            remaining -= min(remaining, len(part))
            if remaining == 0:
                break
    return "".join(parts) + RESET


