def supports_ansi() -> bool:
    return sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb"


def get_terminal_size(default_columns: int = 88) -> os.terminal_size:
    # Query the live TTY first: Screen can inherit stale COLUMNS/LINES values.
    try:
        size = os.get_terminal_size(sys.stdout.fileno())
    except (AttributeError, OSError, ValueError):
        return shutil.get_terminal_size(fallback=(default_columns, 24))
    return os.terminal_size((size.columns or default_columns, size.lines or 24))


def get_terminal_columns(default: int = 88) -> int:
    return get_terminal_size(default).columns


def wrap_for_display(text: str, width: int) -> str:
    wrapper = textwrap.TextWrapper(width=max(1, width), replace_whitespace=False)
    wrapped_lines: List[str] = []
    for line in text.splitlines():
        if not line:
            wrapped_lines.append("")
            continue
        wrapped_lines.extend(wrapper.wrap(line) or [""])
    return "\n".join(wrapped_lines)


def clear_display() -> None:
    if not supports_ansi():
        return
    sys.stdout.write("\033[H\033[2J")
    sys.stdout.flush()


def run_cmd(
    args: Sequence[str],
    *,
    cwd: Optional[Path] = None,
    env: Optional[Dict[str, str]] = None,
    check: bool = True,
    capture: bool = True,
    input_text: Optional[str] = None,
) -> subprocess.CompletedProcess:
    proc = subprocess.run(
        list(args),
        cwd=str(cwd) if cwd else None,
        env=env,
        text=True,
        capture_output=capture,
        input=input_text,
    )
    if check and proc.returncode != 0:
        cmd_str = " ".join(shlex.quote(x) for x in args)
        raise CommandError(
            f"Command failed ({proc.returncode}): {cmd_str}\n"
            f"STDOUT:\n{proc.stdout}\n"
            f"STDERR:\n{proc.stderr}"
        )
    return proc


def relpath_posix(path: Path, start: Path) -> str:
    return str(path.relative_to(start)).replace("\\", "/")


def ensure_binary(name: str) -> None:
    if shutil.which(name) is None:
        raise SystemExit(f"Missing required binary in PATH: {name}")


def resolve_repo_root_from_cwd() -> Path:
    cwd = Path.cwd().resolve()
    proc = run_cmd(["git", "rev-parse", "--show-toplevel"], cwd=cwd)
    return Path(proc.stdout.strip()).resolve()


def get_repo_root() -> Path:
    return resolve_repo_root_from_cwd()


def get_current_branch(repo: Path) -> str:
    proc = run_cmd(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo)
    branch = proc.stdout.strip()
    if branch == "HEAD":
        raise SystemExit("Detached HEAD is not supported.")
    return branch


def get_submodule_paths(repo: Path) -> List[str]:
    gitmodules = repo / ".gitmodules"
    if not gitmodules.is_file():
        return []

    proc = run_cmd(["git", "submodule", "status", "--recursive"], cwd=repo, check=False)
    if proc.returncode not in (0,):
        raise CommandError(f"git submodule status failed:\n{proc.stderr}")

    paths: List[str] = []
    for raw_line in proc.stdout.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        state = line[0]
        body = line[1:].strip()
        parts = body.split()
        if len(parts) < 2:
            continue
        submodule_path = parts[1].replace("\\", "/")
        if state == "-":
            raise CommandError(
                f"Submodule {submodule_path!r} is not initialized. "
                "Initialize submodules before running vybe."
            )
        paths.append(submodule_path)

    return sorted(set(paths), key=lambda value: (value.count("/"), value))


def ensure_clean_repo(repo: Path) -> None:
    proc = run_cmd(["git", "status", "--porcelain"], cwd=repo)
    if proc.stdout.strip():
        raise RetryablePromptError(
            "Working tree is not clean. Commit, stash, or discard local changes first."
        )


def git_remote_url(repo: Path, remote_name: str) -> str:
    proc = run_cmd(["git", "remote", "get-url", remote_name], cwd=repo)
    return proc.stdout.strip()


def has_remote(repo: Path, remote_name: str) -> bool:
    proc = run_cmd(["git", "remote"], cwd=repo)
    remotes = {line.strip() for line in proc.stdout.splitlines() if line.strip()}
    return remote_name in remotes


def tokenized_https_url(url: str, username: str, token: str) -> str:
    if not username or not token:
        return url
    if not url.startswith("https://"):
        raise SystemExit("Only HTTPS remotes are supported for embedded token auth.")
    rest = url[len("https://"):]
    return f"https://{username}:{token}@{rest}"


